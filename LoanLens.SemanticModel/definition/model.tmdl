model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","Customers","Loans"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customers
ref table Loans
ref table Date
ref table 'Cleaning Summary'

ref cultureInfo en-US

