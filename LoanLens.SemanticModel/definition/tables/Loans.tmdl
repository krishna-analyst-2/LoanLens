table Loans
	lineageTag: ce0b5f26-4092-4117-b536-54c5bf2e0b36

	measure 'Total Loans' = COUNTROWS ( Loans )
		formatString: #,0
		displayFolder: Volume
		lineageTag: b37b622e-c01c-4285-a184-06c00894d07c

	measure 'Total Customers' = DISTINCTCOUNT ( Loans[CustomerID] )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 126aa82f-12e1-4464-aa7d-a1b509b23f9b

	measure 'Defaulted Loans' = CALCULATE ( COUNTROWS ( Loans ), Loans[LoanStatus] = "Default" )
		formatString: #,0
		displayFolder: Volume
		lineageTag: d774b0a3-bf6a-4774-9db1-a0acd5991c19

	measure 'Non-Default Loans' = [Total Loans] - [Defaulted Loans]
		formatString: #,0
		displayFolder: Volume
		lineageTag: 687a3a14-abeb-41d6-aba4-a48696eab8e2

	measure 'Default Rate' = DIVIDE ( [Defaulted Loans], [Total Loans] )
		formatString: 0.00%
		displayFolder: Default rate
		lineageTag: 96713a76-5a67-4036-b72c-403436d8df8f

	measure 'Overall Default Rate' = CALCULATE ( [Default Rate], REMOVEFILTERS () )
		formatString: 0.00%
		displayFolder: Default rate
		lineageTag: 960a00bf-179b-4b00-887a-fe3968f6d751

	measure 'Default Rate vs Overall' = [Default Rate] - [Overall Default Rate]
		formatString: 0.00%
		displayFolder: Default rate
		lineageTag: 938452a8-a0f8-47fd-be0b-651e349a34d4

	measure 'Risk Index' = DIVIDE ( [Default Rate], [Overall Default Rate] )
		formatString: 0.00
		displayFolder: Default rate
		lineageTag: 81672276-47c8-447d-9a04-bcac01a192a4

	measure 'Total Loan Amount' = SUM ( Loans[LoanAmount] )
		formatString: #,0
		displayFolder: Money
		lineageTag: 7a409079-3d06-4885-9124-55edfbbb0ff1

	measure 'Avg Loan Amount' = AVERAGE ( Loans[LoanAmount] )
		formatString: #,0
		displayFolder: Money
		lineageTag: 18a75d20-fd27-4312-b593-bf7ce6784ff7

	measure 'Defaulted Amount' = CALCULATE ( SUM ( Loans[LoanAmount] ), Loans[LoanStatus] = "Default" )
		formatString: #,0
		displayFolder: Money
		lineageTag: 9bddb880-f1cc-42b4-8cc9-7a1751d26b62

	measure 'Default Rate by Amount' = DIVIDE ( [Defaulted Amount], [Total Loan Amount] )
		formatString: 0.00%
		displayFolder: Money
		lineageTag: 59a854ae-dee8-4381-9cc6-05debe5d3e0a

	measure 'Avg Interest Rate' = AVERAGE ( Loans[InterestRate] )
		formatString: 0.00
		displayFolder: Borrower profile
		lineageTag: f05b15a4-76e5-463c-861b-18769567094f

	measure 'Avg Credit Score' = AVERAGEX ( Loans, RELATED ( Customers[CreditScore] ) )
		formatString: #,0
		displayFolder: Borrower profile
		lineageTag: 541a8334-4bac-4d2b-a85b-ef26fc32c6f5

	measure 'Avg Income' = AVERAGEX ( Loans, RELATED ( Customers[Income] ) )
