		lineageTag: 4f742166-7356-48bc-b88f-e826b5b79761

	measure 'Default Rate PY' = CALCULATE ( [Default Rate], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.00%
		displayFolder: Time intelligence
		lineageTag: 9d2df16b-f02d-42ef-87a7-46f893f3db3a

	measure 'Default Rate YoY Change' =
			VAR PriorYear = [Default Rate PY]
			RETURN
			    IF ( HASONEVALUE ( 'Date'[Year] ) && NOT ISBLANK ( PriorYear ), [Default Rate] - PriorYear )
		formatString: 0.00%
		displayFolder: Time intelligence
		lineageTag: 1644c5c1-8b1c-4423-9ff4-6381e2a4c202

	measure 'Total Loans PY' = CALCULATE ( [Total Loans], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,0
		displayFolder: Time intelligence
		lineageTag: 411593bb-fc6c-4c2e-bb7d-d3f97166bfb4

	measure 'Loan Growth YoY %' = DIVIDE ( [Total Loans] - [Total Loans PY], [Total Loans PY] )
		formatString: 0.0%
		displayFolder: Time intelligence
		lineageTag: e1ea2773-527d-494a-b6a0-e124aa0c2167

	measure 'Default Rate 12M Rolling' =
			CALCULATE (
			    [Default Rate],
			    DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -12, MONTH )
			)
		formatString: 0.00%
		displayFolder: Time intelligence
		lineageTag: 51c89442-fb45-4a1c-886d-89e3bc87172a

	measure 'Imputed Income Count' = CALCULATE ( COUNTROWS ( Customers ), Customers[IncomeImputed] = TRUE () )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 46738b7c-ba15-46d6-b4dc-1999c361be76

	measure 'Imputed Interest Rate Count' = CALCULATE ( COUNTROWS ( Loans ), Loans[InterestRateImputed] = TRUE () )
		formatString: #,0
