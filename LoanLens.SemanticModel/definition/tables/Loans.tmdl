	measure 'Unknown Loan Term Count' = CALCULATE ( COUNTROWS ( Loans ), ISBLANK ( Loans[LoanTerm] ) )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: a025093a-b6ac-45e1-80d2-d7d30b0d194c

	measure 'Default Rate Headline' =
			"Default rate: " & FORMAT ( [Default Rate], "0.00%" )
			    & " (" & FORMAT ( [Defaulted Loans], "#,0" ) & " of " & FORMAT ( [Total Loans], "#,0" ) & " loans)"
		displayFolder: Dynamic titles
		lineageTag: 3cdf3bcc-33d1-46db-b24e-fe9c32cae062

	measure 'Default Rate vs Prior Year' =
			VAR Change = [Default Rate YoY Change]
			RETURN
			    IF (
			        ISBLANK ( Change ),
			        "Pick one year (2020-2024)",
			        FORMAT ( Change, "+0.00%;-0.00%" ) & " vs " & ( SELECTEDVALUE ( 'Date'[Year] ) - 1 )
			    )
		displayFolder: Time intelligence

