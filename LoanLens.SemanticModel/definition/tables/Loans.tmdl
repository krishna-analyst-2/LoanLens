		lineageTag: 32352023-7688-4981-962e-cea5fb5de1da

	measure 'Unknown Age Count' = CALCULATE ( COUNTROWS ( Customers ), ISBLANK ( Customers[Age] ) )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 34ac8e8a-c7cf-4e22-8f5c-9b72c038c1df

	measure 'Unknown Credit Score Count' = CALCULATE ( COUNTROWS ( Customers ), ISBLANK ( Customers[CreditScore] ) )
		formatString: #,0
